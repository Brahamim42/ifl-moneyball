# il-scout-engine Environment Configuration Example
# Copy this file to .env and fill in your values. Do not commit .env to version control.

# Data Warehouse (MotherDuck / DuckDB)
MOTHERDUCK_TOKEN=
DUCKDB_PATH=data/silver/scout_warehouse.duckdb

# Cloudflare R2 / AWS S3 Decoupled Lakehouse Storage
CLOUDFLARE_R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=il-scout-bronze
R2_ENDPOINT_URL=

# AI Scouting Analyst (Anthropic Claude API)
ANTHROPIC_API_KEY=

# Pipeline Configuration
LOG_LEVEL=INFO
DEFAULT_SEASON_ID=28
DEFAULT_LOOKBACK_DAYS=7
HEADLESS_BROWSER=true

# Alerting & Notifications (GitHub Secrets / Monitoring)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_WEBHOOK_URL=
